<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ryan.yowg.controllers.CredentialController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
         <children>
            <!-- Top Controls -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="SSH Credential Profiles" style="-fx-font-size: 18px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" />
                  <Button fx:id="btnHome" mnemonicParsing="false" text="Dashboard" styleClass="flat" style="-fx-cursor: hand;" />
                  <Button fx:id="btnAdd" mnemonicParsing="false" text="+ New Credential" styleClass="accent" style="-fx-cursor: hand;" />
               </children>
            </HBox>
            
            <!-- Search bar -->
            <TextField fx:id="searchField" promptText="Search credentials by profile name or username..." prefHeight="35.0" />
            
            <!-- List scroll area -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="edge-to-edge">
               <content>
                  <VBox fx:id="listContainer" spacing="10.0">
                     <padding>
                        <Insets bottom="10.0" left="2.0" right="2.0" top="5.0" />
                     </padding>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </children>
</AnchorPane>
