<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="310.0" prefWidth="380.0" spacing="12.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ryan.yowg.controllers.access.EditAccessController">
    <children>
        <TextField fx:id="nameField" promptText="Enter Server Name" />
        <TextField fx:id="addressField" promptText="Enter Host Address (IP or Hostname)" />
        <TextField fx:id="sshUserField" promptText="SSH User (default: administrator)" />
        <TextField fx:id="sshPortField" promptText="SSH Port (default: 22)" />
        <ComboBox fx:id="credentialComboBox" prefWidth="380.0" promptText="Select SSH Credential Profile (Optional)" />
        <ComboBox fx:id="wireguardComboBox" prefWidth="380.0" promptText="Select Associated Wireguard" />
        <HBox alignment="CENTER_RIGHT" spacing="10.0" prefHeight="40.0">
            <children>
                <Button fx:id="cancelButton" text="Cancel" styleClass="flat" style="-fx-cursor: hand;" />
                <Button fx:id="saveButton" text="Save Changes" styleClass="accent" style="-fx-cursor: hand;" />
            </children>
        </HBox>
    </children>
</VBox>
