<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="420.0" prefWidth="380.0" spacing="12.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ryan.yowg.controllers.wireguard.AddWgController">
    <children>
        <TextField fx:id="nameField" promptText="Enter Wireguard Name (e.g. wg0)" />
        <TextField fx:id="noteField" promptText="Enter User Notes" />
        <TextArea fx:id="contentField" prefHeight="220.0" VBox.vgrow="ALWAYS" promptText="Paste Wireguard Configuration File content here..." style="-fx-font-family: monospace;" />
        <HBox alignment="CENTER_RIGHT" spacing="10.0" prefHeight="40.0">
            <children>
                <Button fx:id="cancelButton" text="Cancel" styleClass="flat" style="-fx-cursor: hand;" />
                <Button fx:id="saveButton" text="Save Configuration" styleClass="accent" style="-fx-cursor: hand;" />
            </children>
        </HBox>
    </children>
</VBox>
