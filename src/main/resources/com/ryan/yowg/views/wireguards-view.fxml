<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ryan.yowg.controllers.wireguard.WireguardController" prefHeight="600.0" prefWidth="750.0">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="Wireguard Tunnels" style="-fx-font-size: 18px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" />
                  <Button fx:id="btnHome" mnemonicParsing="false" text="Dashboard" styleClass="flat" style="-fx-cursor: hand;" />
                  <Button fx:id="btnSync" mnemonicParsing="false" text="Sync System Tunnels" styleClass="button" style="-fx-cursor: hand;" />
                  <Button fx:id="btnAdd" mnemonicParsing="false" text="+ New Tunnel" styleClass="accent" style="-fx-cursor: hand;" />

               </children>
            </HBox>
            
            <TextField fx:id="tfSearch" promptText="Search tunnels by name or note..." styleClass="search-field" />
            
            <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" styleClass="edge-to-edge">
               <content>
                  <VBox fx:id="listWireguardContainer" spacing="10.0" style="-fx-background-color: transparent;">
                     <padding>
                        <Insets bottom="5.0" left="2.0" right="2.0" top="5.0" />
                     </padding>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </children>
</AnchorPane>
